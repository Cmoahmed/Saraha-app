PORT=3001
HOST=127.0.0.1
# Use loopback only with the supplied local reverse proxy; false for direct access.
TRUST_PROXY=false
MONGO_URI=mongodb://127.0.0.1:27017/sticky_notes
FRONTEND_ORIGIN=http://localhost:4200
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200
LEGACY_ASSIGNMENT_MODE=true
# Server startup requires JWT ownership on legacy routes. False is classroom-only and insecure.
LEGACY_REQUIRE_AUTH=true
# Generate each key separately; never commit backend/.env.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
JWT_ISSUER=saraha
JWT_AUDIENCE=saraha-client
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
GOOGLE_CLIENT_ID=
# Optional local Redis or Upstash TCP endpoint (rediss:// for TLS). Never paste credentials into docs.
REDIS_URL=
# Independent random secret, at least 32 bytes. Required for OTP/recovery.
OTP_SECRET=
OTP_TTL_SECONDS=300
# Local Mailpit: host 127.0.0.1, port 1025, secure false; inbox http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Saraha <no-reply@localhost>
# Bounded email workflow and optional temporary diagnostics (no credential/OTP logging).
EMAIL_REQUEST_TIMEOUT_MS=20000
EMAIL_DB_TIMEOUT_MS=5000
MAIL_DELIVERY_TIMEOUT_MS=12000
REDIS_OPERATION_TIMEOUT_MS=3000
EMAIL_DIAGNOSTICS=false
